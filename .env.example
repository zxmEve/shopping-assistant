# Runtime
PROCURE_ENVIRONMENT=fixture
PROCURE_REPOSITORY_BACKEND=json
PROCURE_DATABASE_URL=

# Agent topology and model provider
PROCURE_AGENT_MODE=deterministic
PROCURE_AGENT_TOPOLOGY=two_agent
PROCURE_MODEL_PROVIDER=openai
PROCURE_OPENAI_MODEL=gpt-5-mini
PROCURE_REQUIREMENT_MODEL=
PROCURE_SOURCING_MODEL=
PROCURE_OPENAI_BASE_URL=
PROCURE_OPENAI_API_KEY=

# Policy knowledge ingestion and embeddings
PROCURE_KNOWLEDGE_EMBEDDING_PROVIDER=hash
PROCURE_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
PROCURE_KNOWLEDGE_EMBEDDING_BASE_URL=
PROCURE_KNOWLEDGE_EMBEDDING_API_KEY=
PROCURE_KNOWLEDGE_EMBEDDING_BATCH_SIZE=64
PROCURE_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=30
PROCURE_KNOWLEDGE_OCR_PROVIDER=none
PROCURE_KNOWLEDGE_OCR_LANGUAGES=chi_sim+eng
PROCURE_KNOWLEDGE_OCR_TIMEOUT_SECONDS=30
PROCURE_KNOWLEDGE_MAX_FILE_BYTES=10485760
PROCURE_KNOWLEDGE_MAX_PDF_PAGES=200
PROCURE_KNOWLEDGE_MAX_DOCX_UNCOMPRESSED_BYTES=52428800

# Local security and persistence
PROCURE_ACTION_TOKEN_SECRET=replace-this-outside-local-demo
PROCURE_RUN_STORE_PATH=.data/procure-pilot-runs.json

# Harness execution budgets
PROCURE_MAX_AGENT_STEPS=20
PROCURE_MAX_AGENT_TURNS=12
PROCURE_MAX_ORCHESTRATOR_REQUESTS=2
PROCURE_MAX_SPECIALIST_REQUESTS=8
PROCURE_MAX_STAGE_MODEL_REQUESTS=10
PROCURE_MAX_TOOL_CALLS=21
PROCURE_MAX_AGENT_READ_TOOL_CALLS=12
PROCURE_MAX_WORKFLOW_READ_TOOL_CALLS=6
PROCURE_MAX_COMMIT_TOOL_CALLS=3
PROCURE_MAX_PROVIDER_CALLS=12
PROCURE_MAX_RETRIES=4
PROCURE_MAX_INPUT_TOKENS=30000
PROCURE_MAX_OUTPUT_TOKENS=10000
PROCURE_MAX_COST_MICRO_USD=100000
PROCURE_MAX_WALL_TIME_MS=25000
PROCURE_MAX_PARALLEL_PROVIDER_CALLS=4
